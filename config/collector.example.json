{
  "schemaVersion": 1,
  "processName": "stable-corridor-collector",
  "dataRoot": "/var/lib/stable-corridor/data",
  "healthFile": "/var/lib/stable-corridor/state/collector-health.json",
  "journal": {
    "maxPartBytes": 536870912,
    "syncEveryAppend": true
  },
  "storage": {
    "maxDataBytes": 10737418240,
    "minFreeBytes": 42949672960
  },
  "runtime": {
    "healthIntervalMs": 30000,
    "staleCheckIntervalMs": 5000,
    "reconnectDelayMs": 5000,
    "restRequestTimeoutMs": 10000
  },
  "book": {
    "depth": 20,
    "checkpointIntervalMs": 60000
  },
  "coinbase": {
    "products": [
      "EURC-USDC",
      "USDC-EUR"
    ],
    "staleAfterMs": 5000,
    "maxTrackedLevelsPerSide": 10000,
    "maxFrameBytes": 8388608
  },
  "binance": {
    "products": [
      "EURUSDC",
      "EURIUSDC",
      "USDCUSD"
    ],
    "staleAfterMs": 120000,
    "maxTrackedLevelsPerSide": 10000,
    "maxBufferedDepthEvents": 10000,
    "maxFrameBytes": 1048576
  },
  "bybit": {
    "products": [
      "USDTEUR",
      "USDCEUR",
      "USDCUSDT"
    ],
    "staleAfterMs": 30000,
    "maxTrackedLevelsPerSide": 10000,
    "maxRecentTradeIds": 10000,
    "maxFrameBytes": 1048576,
    "pingIntervalMs": 20000
  },
  "kraken": {
    "products": [
      "EURC/USDC",
      "EURC/EUR",
      "EURC/USD",
      "USDC/EUR",
      "USDC/USD"
    ],
    "depth": 25,
    "staleAfterMs": 60000,
    "maxRecentTradeIds": 10000,
    "maxFrameBytes": 1048576
  }
}
